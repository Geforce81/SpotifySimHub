<UserControl x:Class="SpotifySimHub.SpotifySettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="620"
             d:DesignWidth="820"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SpotifyButtonStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="#F5F5F5" />
            </Style>
            <Style BasedOn="{StaticResource SpotifySecondaryButton}"
                   TargetType="Button">
                <Setter Property="Margin" Value="0,0,12,0" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="820"
              Margin="24"
              HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock FontSize="28"
                           FontWeight="SemiBold"
                           Text="SpotifySimHub" />
                <TextBlock Margin="0,6,0,0"
                           Foreground="#A7A7A7"
                           Text="Spotify playback data for SimHub dashboards." />
            </StackPanel>

            <Border Grid.Row="1"
                    Padding="20"
                    Background="#181818"
                    BorderBrush="#333333"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="96"
                            Height="96"
                            Margin="0,0,16,0"
                            Background="#282828"
                            CornerRadius="4">
                        <Image Source="{Binding CoverImage}"
                               Stretch="UniformToFill" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#1ED760"
                                   Text="{Binding ConnectionStatus}" />
                        <TextBlock Margin="0,8,0,0"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Text="{Binding Track, TargetNullValue=No track available}" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="#D0D0D0"
                                   Text="{Binding Artist, TargetNullValue=No artist available}" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="#909090"
                                   Text="{Binding Album, TargetNullValue=No album available}" />
                        <ProgressBar Height="6"
                                     Margin="0,12,0,0"
                                     Background="#333333"
                                     BorderThickness="0"
                                     Foreground="#1ED760"
                                     Maximum="100"
                                     Minimum="0"
                                     Value="{Binding ProgressPercent, Mode=OneWay}" />
                        <TextBlock Margin="0,5,0,0"
                                   HorizontalAlignment="Right"
                                   FontSize="12"
                                   Foreground="#B3B3B3"
                                   Text="{Binding PlaybackTime}" />
                        <StackPanel Margin="0,12,0,0"
                                    Orientation="Horizontal">
                            <Button x:Name="PreviousTrackButton"
                                    Click="PreviousTrackButton_Click"
                                    Content="Previous" />
                            <Button x:Name="TogglePlaybackButton"
                                    Margin="0,0,12,0"
                                    Click="TogglePlaybackButton_Click"
                                    Content="{Binding PlayPauseText}"
                                    Style="{StaticResource SpotifyPrimaryButton}" />
                            <Button x:Name="NextTrackButton"
                                    Click="NextTrackButton_Click"
                                    Content="Next" />
                        </StackPanel>
                        <TextBlock Margin="0,10,0,0"
                                   Foreground="#B3B3B3"
                                   Text="{Binding PlaybackControlStatus}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,5,0,0"
                                   FontSize="12"
                                   Foreground="#909090"
                                   Text="Media controls require Spotify Premium. Existing users must select Reconnect once to grant media control."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Margin="0,20,0,0"
                    Padding="20"
                    Background="#181818"
                    BorderBrush="#333333"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock FontSize="16"
                               FontWeight="SemiBold"
                               Text="Spotify application" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="#B3B3B3"
                               Text="{Binding ClientIdConfigurationStatus}" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="#909090"
                               Text="Copy the Client ID from your app's Settings page and paste it here." />
                    <Button x:Name="SetupGuideButton"
                            HorizontalAlignment="Left"
                            Margin="0,14,0,0"
                            Click="SetupGuideButton_Click"
                            Content="Open setup guide"
                            Style="{StaticResource SpotifyPrimaryButton}" />
                    <DockPanel Margin="0,14,0,0"
                               LastChildFill="True">
                        <Button x:Name="SaveClientIdButton"
                                DockPanel.Dock="Right"
                                Margin="12,0,0,0"
                                Click="SaveClientIdButton_Click"
                                Content="Save Client ID" />
                        <PasswordBox x:Name="ClientIdBox"
                                     MinHeight="36"
                                     Padding="10,7"
                                     PasswordChanged="ClientIdBox_PasswordChanged" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="3" Margin="0,20,0,0">
                <TextBlock Foreground="#B3B3B3"
                           Text="{Binding SavedLoginStatus, StringFormat=Saved login: {0}}" />
                <TextBlock Margin="0,8,0,0"
                           Foreground="#B3B3B3"
                           Text="A browser opens when you select Connect." />
                <TextBlock Margin="0,4,0,0"
                           Foreground="#B3B3B3"
                           Text="If Spotify asks you to connect again later, approve the browser prompt." />
                <TextBlock Margin="0,4,0,0"
                           Foreground="#B3B3B3"
                           Text="Connection closes after two minutes. Select Cancel connection if needed." />

                <TextBlock Margin="0,12,0,0"
                           FontWeight="SemiBold"
                           Foreground="#1ED760"
                           Text="Working...">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Margin="0,18,0,0"
                            Orientation="Horizontal">
                    <Button x:Name="ConnectButton"
                            Margin="0,0,12,0"
                            Click="ConnectButton_Click"
                            Content="Connect"
                            Style="{StaticResource SpotifyPrimaryButton}" />
                    <Button x:Name="DisconnectButton"
                            Click="DisconnectButton_Click"
                            Content="Disconnect" />
                    <Button x:Name="RefreshButton"
                            Click="RefreshButton_Click"
                            Content="Refresh status" />
                    <Button x:Name="CancelButton"
                            Click="CancelButton_Click"
                            Content="Cancel connection" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
