<UserControl x:Class="SpotifySimHub.SpotifySettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="620"
             d:DesignWidth="820"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F5F5F5" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Padding" Value="16,9" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="820"
              Margin="24"
              HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock FontSize="28"
                           FontWeight="SemiBold"
                           Text="SpotifySimHub" />
                <TextBlock Margin="0,6,0,0"
                           Foreground="#A7A7A7"
                           Text="Spotify playback data for SimHub dashboards." />
            </StackPanel>

            <Border Grid.Row="1"
                    Padding="20"
                    Background="#181818"
                    BorderBrush="#333333"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="96"
                            Height="96"
                            Margin="0,0,16,0"
                            Background="#282828"
                            CornerRadius="4">
                        <Image Source="{Binding CoverImage}"
                               Stretch="UniformToFill" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#1ED760"
                                   Text="{Binding ConnectionStatus}" />
                        <TextBlock Margin="0,8,0,0"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Text="{Binding Track, TargetNullValue=No track available}" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="#D0D0D0"
                                   Text="{Binding Artist, TargetNullValue=No artist available}" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="#909090"
                                   Text="{Binding Album, TargetNullValue=No album available}" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Margin="0,20,0,0">
                <TextBlock Foreground="#B3B3B3"
                           Text="{Binding SavedLoginStatus, StringFormat=Saved login: {0}}" />
                <TextBlock Margin="0,8,0,0"
                           Foreground="#B3B3B3"
                           Text="Login opens only when Connect or Reconnect is selected." />

                <TextBlock Margin="0,12,0,0"
                           FontWeight="SemiBold"
                           Foreground="#1ED760"
                           Text="Working...">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Margin="0,18,0,0"
                            Orientation="Horizontal">
                    <Button x:Name="ConnectButton"
                            Click="ConnectButton_Click"
                            Content="Connect" />
                    <Button x:Name="DisconnectButton"
                            Click="DisconnectButton_Click"
                            Content="Disconnect" />
                    <Button x:Name="RefreshButton"
                            Click="RefreshButton_Click"
                            Content="Refresh status" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
